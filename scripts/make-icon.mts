// Regenerates 00Dojo's icons from the drawing in web/src/brand.ts:
//   assets/icon.svg        the source drawing, with its orange tile
//   assets/00Dojo.icns      the Mac app icon, every size from 16 to 1024 px
//   web/public/favicon.svg the browser tab icon
// Run with: npx tsx scripts/make-icon.mts   (needs Playwright, used only to turn the SVG into PNGs)
import fs from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { markSvg, type Pose } from '../web/src/brand.ts';

const POSE: Pose = 'sides';
const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const svg = markSvg({ pose: POSE, tile: true, id: 'chiba' });

fs.writeFileSync(path.join(root, 'assets', 'icon.svg'), `<!-- 00Dojo's Mac app icon. Generated by scripts/make-icon.mts from web/src/brand.ts; edit those, not this. -->\n${svg}\n`);
// The tab icon and sidebar logo are cropped to the tile: the Mac icon's margin would only waste a 16 px tab.
fs.writeFileSync(path.join(root, 'web', 'public', 'favicon.svg'), `${svg.replace('viewBox="0 0 1024 1024"', 'viewBox="100 100 824 824"')}\n`);

// The .icns entries macOS reads, each a PNG: type code and pixel size.
const ENTRIES: [string, number][] = [
  ['icp4', 16],
  ['icp5', 32],
  ['ic11', 32],
  ['ic12', 64],
  ['ic07', 128],
  ['ic13', 256],
  ['ic08', 256],
  ['ic14', 512],
  ['ic09', 512],
  ['ic10', 1024],
];

const require = createRequire(import.meta.url);
let playwright: typeof import('playwright');
try {
  playwright = require('playwright');
} catch {
  console.error('This needs Playwright to draw the PNGs: npm i -D playwright, then run it again.');
  process.exit(1);
}

const browser = await playwright.chromium.launch();
const page = await browser.newPage();
const pngs = new Map<number, Buffer>();
for (const size of new Set(ENTRIES.map(([, s]) => s))) {
  await page.setViewportSize({ width: size, height: size });
  await page.setContent(`<html><body style="margin:0;background:transparent">${svg.replace('<svg ', `<svg width="${size}" height="${size}" `)}</body></html>`);
  pngs.set(size, await page.screenshot({ omitBackground: true, clip: { x: 0, y: 0, width: size, height: size } }));
}
await browser.close();

const parts = ENTRIES.map(([type, size]) => {
  const png = pngs.get(size)!;
  const head = Buffer.alloc(8);
  head.write(type, 0, 'latin1');
  head.writeUInt32BE(png.length + 8, 4);
  return Buffer.concat([head, png]);
});
const body = Buffer.concat(parts);
const header = Buffer.alloc(8);
header.write('icns', 0, 'latin1');
header.writeUInt32BE(body.length + 8, 4);
fs.writeFileSync(path.join(root, 'assets', '00Dojo.icns'), Buffer.concat([header, body]));
console.log(`Wrote assets/00Dojo.icns (${ENTRIES.length} sizes), assets/icon.svg and web/public/favicon.svg`);
